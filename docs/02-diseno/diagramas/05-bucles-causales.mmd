flowchart LR
    HE[Horas extra]
    PR[Presión / sobrecompromiso]
    DT[DeudaTecnica]
    VE[Velocidad]
    AV[Avance]
    FA[Cansancio]
    MO[MoralEquipo]
    CO[Cobertura]
    DO[Documentacion]
    CP[Competencia]
    RL[RiesgoLatente]
    EV[Eventos negativos]
    QA["Pruebas, programación en pareja, revisión de PR"]
    DE["Irse a casa a las 18:00"]

    %% R1 · Presión → deuda (refuerzo)
    HE -->|+| PR -->|+| DT -->|-| VE -->|+| AV
    %% R2 · Agotamiento (refuerzo)
    HE -->|+| FA -->|-| MO -->|+| VE
    FA -->|-| VE
    %% R3 · Dilución de la calidad (refuerzo)
    AV -->|-| CO
    AV -->|-| DO
    %% R4 · Riesgo → eventos (refuerzo)
    DT -->|+| RL
    FA -->|+| RL
    CO -->|-| RL
    DO -->|-| RL
    RL -->|+| EV -->|+| DT

    %% B1 · Inversión en calidad (equilibrio)
    QA -->|+| CO
    QA -->|-| DT
    %% B2 · Cuidado del equipo (equilibrio)
    DE -->|-| FA
    DE -->|+| MO
    %% B3 · Documentación → competencia (equilibrio)
    DO -->|+| CP -->|+| VE
